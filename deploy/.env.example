# The public name of this server. With no domain of your own, use the server's IP address
# with dashes plus .sslip.io, for example 3-14-15-92.sslip.io for the address 3.14.15.92.
# Several names can be listed, separated by ", ". Any prefix works in front of an sslip.io
# name, for example graphu.3-14-15-92.sslip.io.
GRAPHU_DOMAIN=

# Optional. Without it the live site shows the sample only.
ANTHROPIC_API_KEY=
